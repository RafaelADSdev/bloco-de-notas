{
  "name": "linha-clara",
  "private": true,
  "description": "Cadernos, anotações em PDF e desenho em camadas.",
  "version": "1.0.5",
  "type": "module",
  "scripts": {
    "build": "vite build && node scripts/static-routes.mjs",
    "build:android": "npm run build && cap sync android",
    "build:desktop": "npm run build && node scripts/stage-desktop.mjs",
    "package:windows": "npm run build:desktop && electron-builder --win nsis --x64 --publish never --config desktop/electron-builder.json",
    "package:macos": "npm run build:desktop && node scripts/package-macos.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/core": "8.6.2",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "ag-psd": "34.2.3",
    "lucide-react": "0.468.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.5.438",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "@electron/packager": "20.3.0",
    "electron": "45.5.0",
    "electron-builder": "26.18.0",
    "vite": "8.3.8"
  },
  "productName": "Linha Clara",
  "main": "desktop/main.cjs"
}
